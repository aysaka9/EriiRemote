{
  "name": "erii-remote",
  "version": "1.4.2",
  "description": "EriiRemote - 基于 EasyTier 的开源高颜值异地虚拟局域网与远程桌面控制中心",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "download-easytier": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-easytier.ps1",
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.2.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.erii.remote",
    "productName": "Erii远程",
    "copyright": "Copyright © 2026 EriiRemote Contributors",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/easytier",
        "to": "easytier"
      },
      {
        "from": "resources/default_config.json",
        "to": "default_config.json"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Erii远程",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "language": "2052",
      "deleteAppDataOnUninstall": false
    }
  }
}
